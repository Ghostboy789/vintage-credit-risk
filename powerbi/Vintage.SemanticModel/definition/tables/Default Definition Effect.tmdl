	partition 'Default Definition Effect' = m
		mode: import
		source =
				let
				    Source = Csv.Document(VintageFile("default_definition_effect.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
