				    Typed = Table.TransformColumnTypes(Blanks, {{"vintage_year", Int64.Type}, {"defaults_12m_primary", type number}, {"defaults_12m_primary_lo", type number}, {"defaults_12m_primary_hi", type number}, {"defaults_12m_primary_n", Int64.Type}, {"defaults_12m_primary_method", type text}, {"defaults_12m_naive", type number}, {"defaults_12m_naive_lo", type number}, {"defaults_12m_naive_hi", type number}, {"defaults_12m_naive_n", Int64.Type}, {"defaults_12m_naive_method", type text}, {"synthetic", type logical}}, "en-US")
