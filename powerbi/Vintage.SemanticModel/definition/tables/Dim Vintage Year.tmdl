table 'Dim Vintage Year'
	lineageTag: 103e8562-fe37-44e7-9296-513a8bf375a9

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 40d19cb0-191f-4336-a5ff-5ac94aee03c8
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	partition 'Dim Vintage Year' = m
		mode: import
		source =
				let
				    Years = Table.Combine({Table.RenameColumns(Table.TransformColumnTypes(Table.SelectColumns(Table.PromoteHeaders(Csv.Document(VintageFile("vintage_curves.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])), {"vintage_year"}), {{"vintage_year", Int64.Type}}), {{"vintage_year", "vintage_year"}}), Table.RenameColumns(Table.TransformColumnTypes(Table.SelectColumns(Table.PromoteHeaders(Csv.Document(VintageFile("default_definition_effect.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])), {"vintage_year"}), {{"vintage_year", Int64.Type}}), {{"vintage_year", "vintage_year"}}), Table.RenameColumns(Table.TransformColumnTypes(Table.SelectColumns(Table.PromoteHeaders(Csv.Document(VintageFile("default_cure_rates.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])), {"default_year"}), {{"default_year", Int64.Type}}), {{"default_year", "vintage_year"}}), Table.RenameColumns(Table.TransformColumnTypes(Table.SelectColumns(Table.PromoteHeaders(Csv.Document(VintageFile("lgd_resolution_mix.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])), {"default_year"}), {{"default_year", Int64.Type}}), {{"default_year", "vintage_year"}})}),
				    Distinct = Table.Distinct(Table.RenameColumns(Table.SelectRows(Years, each [vintage_year] <> null), {{"vintage_year", "Year"}}))
				in
				    Distinct

	annotation PBI_ResultType = Table
